; ---------------------------------------------------------------
; ESP32-S3 / S2 native USB CDC port driver for Windows 7
; Binds the built-in usbser.sys to the USB JTAG/serial debug unit
; Hardware IDs covered:
;   USB\VID_303A&PID_1001&MI_00   (ESP32-S3)
;   USB\VID_303A&PID_0002&MI_00   (ESP32-S2)
; ---------------------------------------------------------------
[Version]
Signature="$Windows NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=07/01/2020,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%Provider%=DeviceList,NTx86,NTamd64

[DeviceList.NTx86]
%DeviceDesc%=DriverInstall,USB\VID_303A&PID_1001&MI_00
%DeviceDesc%=DriverInstall,USB\VID_303A&PID_0002&MI_00

[DeviceList.NTamd64]
%DeviceDesc%=DriverInstall,USB\VID_303A&PID_1001&MI_00
%DeviceDesc%=DriverInstall,USB\VID_303A&PID_0002&MI_00

[DriverInstall.NT]
CopyFiles=CopyFiles_None

[DriverInstall.NT.HW]
AddReg=DriverInstall.HW.AddReg

[DriverInstall.NT.Services]
AddService=usbser,0x0002,ServiceSection

[CopyFiles_None]

[DriverInstall.HW.AddReg]
HKR,,PortSubClass,1,01

[ServiceSection]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\usbser.sys
LoadOrderGroup=Base

[Strings]
Provider="Serialplot"
DeviceDesc="USB JTAG/serial debug unit (COM port)"
ServiceName="USB Serial Port Driver"